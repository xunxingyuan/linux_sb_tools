{
  "manifest_version": 3,
  "name": "LINUX SB 扩展工具箱",
  "version": "0.8.0",
  "description": "LINUX SB 扩展工具箱，提供称号抽取统计、熔铸助手和本地图片压缩上传。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://linux.sb/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINUX SB 扩展工具箱",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://linux.sb/gacha"],
      "js": ["lib/parser.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://linux.sb/gacha_forge_center"],
      "js": ["lib/parser.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://linux.sb/topic_edit", "https://linux.sb/topic/*"],
      "js": ["image-host.js"],
      "css": ["image-host.css"],
      "run_at": "document_idle"
    }
  ]
}
