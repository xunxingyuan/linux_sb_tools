{
  "manifest_version": 3,
  "name": "LINUX SB 扩展工具箱",
  "version": "0.12.0",
  "description": "LINUX SB 扩展工具箱，提供称号统计、熔铸助手和市场价格提醒。",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://linux.sb/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "LINUX SB 扩展工具箱",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://linux.sb/gacha"
      ],
      "js": [
        "lib/state.js",
        "lib/parser.js",
        "lib/forge.js",
        "lib/history.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://linux.sb/gacha_forge_center"
      ],
      "js": [
        "lib/state.js",
        "lib/parser.js",
        "lib/forge.js",
        "lib/history.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
